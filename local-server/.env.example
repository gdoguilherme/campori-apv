# Configuração do servidor local do Campori APV.
# Copie para ".env" (o INSTALAR.bat já faz isso) e preencha.

# OBRIGATÓRIO: tem que ser IDÊNTICO ao QR_SECRET configurado no servidor da nuvem (Fly.io),
# senão os QR Codes já impressos ficam inválidos no modo offline.
QR_SECRET=

# Porta em que o servidor escuta na rede local (celulares acessam http://IP-DO-PC:PORTA)
PORT=8787

# OBRIGATÓRIO NO EVENTO: tem que ser IDÊNTICO ao JWT_SECRET da nuvem (Fly.io). Assim o login
# feito no servidor local também vale na nuvem (e vice-versa) quando o app troca de servidor,
# e a fila offline não é rejeitada por "token de outro servidor".
# (Em testes locais, se vazio, é gerado automaticamente — mas aí NÃO use no evento.)
JWT_SECRET=
