# Configuração do servidor local do Campori APV.
# Copie para ".env" (o INSTALAR.bat já faz isso) e preencha.

# OBRIGATÓRIO: tem que ser IDÊNTICO ao QR_SECRET configurado no servidor da nuvem (Fly.io),
# senão os QR Codes já impressos ficam inválidos no modo offline.
QR_SECRET=

# Porta HTTP (testes no próprio PC, health do watchdog). Os celulares usam HTTPS (abaixo).
PORT=8787

# ── HTTPS (obrigatório para o app instalado nos celulares) ──────────────────────
# Arquivos gerados pelo win-acme (formato PEM) — ver "HTTPS" no GUIA-WINDOWS.md.
# Caminho relativo = a partir da pasta local-server. Se os arquivos não existirem, o servidor
# sobe só em HTTP e avisa no log. NUNCA coloque estes arquivos no git (a pasta certs/ já é ignorada).
HTTPS_CERT_PATH=certs/local.gdtmidia.com.br-chain.pem
HTTPS_KEY_PATH=certs/local.gdtmidia.com.br-key.pem
HTTPS_PORT=443

# Opcional: outras origens (páginas) autorizadas a chamar a API, separadas por vírgula.
# Já aceitas: https://campori.gdtmidia.com.br, https://local.gdtmidia.com.br e localhost.
CORS_ORIGINS=

# OBRIGATÓRIO NO EVENTO: tem que ser IDÊNTICO ao JWT_SECRET da nuvem (Fly.io). Assim o login
# feito no servidor local também vale na nuvem (e vice-versa) quando o app troca de servidor,
# e a fila offline não é rejeitada por "token de outro servidor".
# (Em testes locais, se vazio, é gerado automaticamente — mas aí NÃO use no evento.)
JWT_SECRET=

# ── Sincronização com a nuvem (Firebase) ────────────────────────────────────────
# 0 = desligada (padrão: evita gravar dados de teste na nuvem de produção). No PC do evento, depois de
# conferir o GUIA-WINDOWS.md (passo "Sincronização"), mude para 1.
CLOUD_SYNC=0
# Credenciais (JSON da service account do Firebase). Vazio = ..\server\campori-apv-firebase-adminsdk.json
FIREBASE_CREDENTIALS_FILE=

# ── Painel de status (http://localhost:8787/status) ──────────────────────────────
# No próprio PC abre direto. De OUTRO aparelho (celular/tablet) pede este PIN. Vazio = só abre no PC.
STATUS_PIN=

# ── Página de ajuda para os celulares (https://local.gdtmidia.com.br/ajuda) ──────────
# Nome da rede Wi-Fi do evento (aparece na ajuda). A senha é opcional: só preencha se puder ficar exposta na página.
HELP_WIFI_NAME=
HELP_WIFI_PASSWORD=

# ── Modo local total (todos os perfis usando este servidor como backend) ─────────────
# 1 (padrão) = as páginas servidas por este servidor usam o banco local; a NUVEM não muda.
# 0 = CHAVE DE EMERGÊNCIA: volta ao comportamento anterior (Firestore direto). Reinicie o servidor depois de mudar.
LOCAL_APP_MODE=1
