{
  "name": "campori-local-server",
  "version": "1.0.0",
  "description": "Servidor local (offline) do Campori APV — Express + SQLite, roda no PC do evento",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/supervisor.js",
    "server": "node src/server.js",
    "demo": "node scripts/seed-demo.js && node src/supervisor.js",
    "seed-demo": "node scripts/seed-demo.js",
    "pull-cloud": "node scripts/pull-from-firestore.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.1.1"
  }
}
